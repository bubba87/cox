# === PCQ - Configuration ===

# IP de l'onduleur Huawei sur le réseau local
INVERTER_IP=192.168.1.100

# Intervalle de collecte en secondes (60 = 1 min)
COLLECT_INTERVAL=60

# Configuration Huawei FusionSolar (uniquement pour le mode cloud)
HUAWEI_FUSIONSOLAR_USER=votre_email@example.com
HUAWEI_FUSIONSOLAR_PASS=votre_mot_de_passe
HUAWEI_STATION_CODE=votre_code_station

# Le code station se trouve dans l'URL FusionSolar :
# https://intl.fusionsolar.huawei.com/#/station/overview?stationCode=XXXX
